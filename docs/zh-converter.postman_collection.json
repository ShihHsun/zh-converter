{
  "info": {
    "name": "zh-converter",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "directions 轉換方向清單",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/convert/directions",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "convert",
            "directions"
          ]
        }
      }
    },
    {
      "name": "convert 成功（預設簡轉繁）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/convert",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "convert"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"这个软件的默认设置在数据库里\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "convert 成功（繁轉簡）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/convert",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "convert"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"這個軟體很好用\",\n  \"direction\": \"tw-to-cn\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "400 TEXT_REQUIRED（沒填 text）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/convert",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "convert"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "400 TEXT_INVALID_TYPE（text 不是字串）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/convert",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "convert"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": 123\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "400 TEXT_EMPTY（只有空白）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/convert",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "convert"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"   \"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "400 DIRECTION_UNSUPPORTED（方向錯誤）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/convert",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "convert"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"你好\",\n  \"direction\": \"abc\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "400 INVALID_JSON（JSON 格式錯誤）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/convert",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "convert"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{ \"text\": ",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "413 TEXT_TOO_LONG（超過 10,000 字）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/convert",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "convert"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"{{longText}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('longText', '字'.repeat(10001));"
            ]
          }
        }
      ]
    },
    {
      "name": "413 PAYLOAD_TOO_LARGE（body 超過 100kb）",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/convert",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "convert"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"{{bigText}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set('bigText', 'a'.repeat(120000));"
            ]
          }
        }
      ]
    },
    {
      "name": "404 NOT_FOUND（路徑不存在）",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/abc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "abc"
          ]
        }
      }
    }
  ]
}