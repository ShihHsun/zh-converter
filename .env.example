# 複製一份為 .env 後再修改；沒設定的項目會使用 src/config/index.js 裡的預設值

# 伺服器埠號
PORT=3000

# 允許的前端來源：* 或以逗號分隔的多個網址（例如 http://localhost:5173,https://example.com）
CORS_ORIGIN=*

# 文字轉換的字數上限
MAX_TEXT_LENGTH=10000

# 上傳檔案大小上限（單位：位元組，預設 1MB）
MAX_FILE_SIZE=1048576

# 頻率限制：每個 IP 在 RATE_LIMIT_WINDOW_MS 毫秒內最多 RATE_LIMIT_MAX 次請求
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
